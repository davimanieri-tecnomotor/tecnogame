# Normalise line endings so the repo stays LF regardless of who commits.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.mp4 binary
*.ttf binary
*.otf binary
*.zip binary

# Generated: keep it out of diffs and language stats.
web/js/bundle.js linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
